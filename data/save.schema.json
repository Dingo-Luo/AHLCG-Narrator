{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "诡镇档案本地存档 v1",
  "type": "object",
  "required": ["version", "campaignId", "name", "investigators", "events"],
  "properties": {
    "version": { "const": 1 },
    "campaignId": { "enum": ["core", "dwl", "ptc"] },
    "name": { "type": "string", "maxLength": 80 },
    "flow": { "const": "story" },
    "createdAt": { "type": "string" },
    "cursor": { "type": "integer", "minimum": 0 },
    "cardViews": { "type": "object" },
    "sourceRevision": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "investigators": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "required": ["id", "name"],
        "properties": { "id": { "type": "string", "pattern": "^i[1-4]$" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "card": { "type": ["string", "null"] } }
      }
    },
    "events": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "required": ["type"],
        "properties": {
          "type": { "enum": ["difficulty", "start", "advance", "resolution", "finish", "adjust", "reveal", "story_only", "next_card", "record_action", "story_action"] },
          "scenario": { "type": "string" }, "value": { "type": ["string", "boolean"] },
          "deck": { "enum": ["agenda", "act"] },
          "id": { "type": "string" }, "statuses": { "type": "object", "additionalProperties": { "enum": ["survived", "resigned", "physical", "mental", "both", "eliminated"] } },
          "answer": { "type": ["string", "integer", "object", "array"] },
          "lead": { "type": "string", "pattern": "^i[1-4]$" },
          "investigator": { "type": "string" }, "field": { "enum": ["earned", "spent", "physical", "mental"] },
          "delta": { "type": "integer" }, "card": { "type": "string" }, "side": { "enum": ["front", "back"] }
        }
      }
    }
  },
  "$comment": "Runtime validation also replays every event to verify legal order, valid choices, content version, integer bounds and XP balance."
}
